# ==============================================================================
# AegisGov AI - Environment Configuration Template
# Copy this file to '.env' and customize values for your deployment.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration
# ------------------------------------------------------------------------------
# The port on which the AegisGov AI middleware API gateway listens
PORT=4000

# Application runtime environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Seed demo data on initial launch: 'true' | 'false'
# Set to 'false' to start the system completely BLANK with 0 agents, 0 sources, 0 models.
SEED_DEMO_DATA=false

# Allowed origins for Cross-Origin Resource Sharing (CORS)
# In production, set to your specific frontend domain (e.g. https://governance.corp.internal)
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Vault (ISO/IEC 42001 & SOC 2)
# ------------------------------------------------------------------------------
# Master secret used by CryptoService to:
#  - Derive the 256-bit encryption key (scrypt/PBKDF2) for AES-256-GCM database credentials.
#  - Salt the one-way SHA-256 hashes of agent API keys.
# REQUIRED FOR PRODUCTION: Set a strong, randomly generated 64-character secret.
# Example generation: openssl rand -hex 32
AEGIS_MASTER_KEY=change-this-to-a-secure-random-64-character-master-key-in-production

# ------------------------------------------------------------------------------
# 3. Client & Frontend (Vite)
# ------------------------------------------------------------------------------
# Base API URL used by the web dashboard to communicate with the gateway.
# When deploying frontend and backend separately, update this URL accordingly.
VITE_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 4. Optional: External LLM & Cloud Integrations
# ------------------------------------------------------------------------------
# If enabling direct gateway proxying to upstream frontier models:
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...

# Optional: Cloud Data Lake Credentials (if using Pattern B: STS Broker)
# AWS_REGION=eu-west-1
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/AegisGovDataLakeBroker
# GCP_PROJECT_ID=my-gcp-project
# SNOWFLAKE_ACCOUNT=xy12345.eu-west-1

